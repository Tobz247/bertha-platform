# PostgreSQL connection string
DATABASE_URL="postgresql://bertha:bertha@localhost:5432/bertha?schema=public"
# Optional: a direct (non-pooled) connection for migrations, if DATABASE_URL goes through a pooler (Neon sets this)
# DATABASE_URL_UNPOOLED=""
# Comma-separated emails that get the platform admin pages (supplier checks, categories)
ADMIN_EMAILS="you@example.com"
# Long random string used to sign login sessions (e.g. `openssl rand -base64 32`)
SESSION_SECRET="change-me-to-a-long-random-string"
