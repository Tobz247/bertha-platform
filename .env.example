# PostgreSQL connection string
DATABASE_URL="postgresql://bertha:bertha@localhost:5432/bertha?schema=public"
# Direct (non-pooled) connection for migrations. Same as DATABASE_URL when you have no pooler.
DATABASE_URL_UNPOOLED="postgresql://bertha:bertha@localhost:5432/bertha?schema=public"
# Comma-separated emails that get the platform admin pages (supplier checks, categories)
ADMIN_EMAILS="you@example.com"
# Long random string used to sign login sessions (e.g. `openssl rand -base64 32`)
SESSION_SECRET="change-me-to-a-long-random-string"
