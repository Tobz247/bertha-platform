// Bertha Services: procurement, orders and inventory for food businesses.
// Money is stored in whole Naira (Int). Quantities are Float (e.g. 2.5 kg).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessType {
  BUYER
  SUPPLIER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// OWNER, MANAGER and STAFF are general roles. The others are job roles in a hotel or restaurant.
// What each role can do lives in src/lib/roles.ts.
enum UserRole {
  OWNER
  MANAGER
  STAFF
  PROCUREMENT
  KITCHEN
  STOREKEEPER
  ACCOUNTS
}

model Business {
  id                String             @id @default(cuid())
  name              String
  type              BusinessType
  cacNumber         String?
  phone             String
  address           String
  area              String // e.g. Wuse, Garki, Gwagwalada
  state             String             @default("FCT")
  verification      VerificationStatus @default(PENDING)
  approvalLimit     Int? // buyers: POs above this total (Naira) need a manager's approval
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  deliveryFee       Int                @default(0) // suppliers: standard delivery fee on price-list orders
  minOrderValue     Int? // suppliers: smallest price-list order they accept (Naira)
  createdAt         DateTime           @default(now())

  // suppliers: criteria buyers and admins use to judge them
  supplierKind    String? // Farmer, Wholesaler, Distributor, Manufacturer, Market trader, Importer
  yearsInBusiness Int?
  deliveryAreas   String? // comma-separated Abuja areas they deliver to
  deliveryDays    String? // comma-separated, e.g. "Mon,Tue,Wed"
  orderNoticeDays Int? // notice needed before delivery; 0 = same day
  paymentTerms    String? // comma-separated: CASH, TRANSFER, 7, 14, 30 (days of credit)
  coldChain       Boolean @default(false) // refrigerated storage or delivery
  nafdacNumber    String?
  tin             String? // tax identification number
  hygieneCert     Boolean @default(false) // food handler / hygiene certificate
  weeklyCapacity  String? // what they can supply in a week, in their own words
  references      String? // other hotels or restaurants they supply

  users          User[]
  categories     Category[]           @relation("SupplierCategories")
  requests       Request[]            @relation("BuyerRequests")
  invites        RequestInvite[]
  quotes         Quote[]
  buyerOrders    PurchaseOrder[]      @relation("BuyerOrders")
  supplierOrders PurchaseOrder[]      @relation("SupplierOrders")
  stockItems     StockItem[]
  ratingsGiven   Rating[]             @relation("RatingBuyer")
  ratingsGot     Rating[]             @relation("RatingSupplier")
  catalogue      CatalogItem[]
  recipes        Recipe[]
  portionRuns    PortionRun[]
  auditEntries   AuditLog[]
  priceChanges   CatalogPriceChange[]
  rateCards      RateCard[]
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  phone           String?
  passwordHash    String
  role            UserRole  @default(STAFF)
  isPlatformAdmin Boolean   @default(false)
  active          Boolean   @default(true) // false = login turned off by an owner, manager or admin
  lastLoginAt     DateTime?
  businessId      String?
  business        Business? @relation(fields: [businessId], references: [id])
  createdAt       DateTime  @default(now())

  requestsCreated Request[]       @relation("RequestCreator")
  ordersCreated   PurchaseOrder[] @relation("OrderCreator")
  ordersApproved  PurchaseOrder[] @relation("OrderApprover")
  ordersReceived  PurchaseOrder[] @relation("OrderReceiver")
  portionRuns     PortionRun[]
  payments        Payment[]
  movements       StockMovement[]
  events          OrderEvent[]
  dishSales       DishSale[]
  auditEntries    AuditLog[]
}

model Category {
  id        String        @id @default(cuid())
  name      String        @unique
  units     String // comma-separated suggested units, e.g. "kg,basket,bag"
  suppliers Business[]    @relation("SupplierCategories")
  requests  Request[]
  catalogue CatalogItem[]
}

enum RequestStatus {
  OPEN
  AWARDED
  CLOSED
  CANCELLED
}

enum RequestAudience {
  ALL_VERIFIED
  SHORTLIST
}

model Request {
  id              String          @id @default(cuid())
  number          Int             @unique @default(autoincrement())
  title           String
  buyerId         String
  buyer           Business        @relation("BuyerRequests", fields: [buyerId], references: [id])
  categoryId      String
  category        Category        @relation(fields: [categoryId], references: [id])
  deliveryAddress String
  neededBy        DateTime
  quoteDeadline   DateTime
  audience        RequestAudience @default(ALL_VERIFIED)
  status          RequestStatus   @default(OPEN)
  notes           String?
  createdById     String
  createdBy       User            @relation("RequestCreator", fields: [createdById], references: [id])
  createdAt       DateTime        @default(now())

  lines   RequestLine[]
  invites RequestInvite[]
  quotes  Quote[]
  orders  PurchaseOrder[]
}

model RequestLine {
  id         String      @id @default(cuid())
  requestId  String
  request    Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product    String
  quantity   Float
  unit       String
  notes      String?
  position   Int         @default(0)
  quoteLines QuoteLine[]
}

model RequestInvite {
  requestId  String
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Business @relation(fields: [supplierId], references: [id])

  @@id([requestId, supplierId])
}

enum QuoteStatus {
  SUBMITTED
  AWARDED
  NOT_SELECTED
  WITHDRAWN
}

model Quote {
  id           String         @id @default(cuid())
  requestId    String
  request      Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  supplierId   String
  supplier     Business       @relation(fields: [supplierId], references: [id])
  deliveryFee  Int            @default(0)
  deliveryDate DateTime
  validUntil   DateTime
  notes        String?
  status       QuoteStatus    @default(SUBMITTED)
  createdAt    DateTime       @default(now())
  lines        QuoteLine[]
  order        PurchaseOrder?

  @@unique([requestId, supplierId])
}

model QuoteLine {
  id            String      @id @default(cuid())
  quoteId       String
  quote         Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  requestLineId String
  requestLine   RequestLine @relation(fields: [requestLineId], references: [id], onDelete: Cascade)
  unitPrice     Int
}

enum OrderSource {
  QUOTE // awarded from a request for quotes
  PRICE_LIST // ordered straight from a supplier's price list
}

enum OrderStatus {
  AWAITING_APPROVAL
  NOT_APPROVED
  AWAITING_SUPPLIER
  DECLINED
  CONFIRMED
  DISPATCHED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id               String      @id @default(cuid())
  number           Int         @unique @default(autoincrement())
  buyerId          String
  buyer            Business    @relation("BuyerOrders", fields: [buyerId], references: [id])
  supplierId       String
  supplier         Business    @relation("SupplierOrders", fields: [supplierId], references: [id])
  requestId        String?
  request          Request?    @relation(fields: [requestId], references: [id])
  quoteId          String?     @unique
  quote            Quote?      @relation(fields: [quoteId], references: [id])
  status           OrderStatus
  paymentTermsDays Int         @default(0) // 0 = pay on delivery
  deliveryFee      Int         @default(0)
  deliveryDate     DateTime
  deliveryAddress  String
  createdById      String
  createdBy        User        @relation("OrderCreator", fields: [createdById], references: [id])
  approvedById     String?
  approvedBy       User?       @relation("OrderApprover", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  decisionNote     String?
  receivedAt       DateTime?
  receivedById     String?
  receivedBy       User?       @relation("OrderReceiver", fields: [receivedById], references: [id])
  createdAt        DateTime    @default(now())

  lines     OrderLine[]
  invoice   Invoice?
  source    OrderSource     @default(QUOTE)
  payments  Payment[]
  events    OrderEvent[]
  rating    Rating?
  movements StockMovement[]
}

model OrderLine {
  id          String        @id @default(cuid())
  orderId     String
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     String
  unit        String
  quantity    Float
  unitPrice   Int
  receivedQty Float?
  issue       String? // Short delivery, Poor quality, Wrong item
  position    Int           @default(0)
}

model Invoice {
  id       String        @id @default(cuid())
  orderId  String        @unique
  order    PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  number   String
  amount   Int
  issuedAt DateTime      @default(now())
}

enum PaymentMethod {
  CASH
  TRANSFER
}

model Payment {
  id           String        @id @default(cuid())
  orderId      String
  order        PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method       PaymentMethod
  amount       Int
  reference    String?
  paidAt       DateTime
  recordedById String
  recordedBy   User          @relation(fields: [recordedById], references: [id])
  createdAt    DateTime      @default(now())
}

model OrderEvent {
  id      String        @id @default(cuid())
  orderId String
  order   PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorId String?
  actor   User?         @relation(fields: [actorId], references: [id])
  message String
  at      DateTime      @default(now())
}

model Rating {
  id         String        @id @default(cuid())
  orderId    String        @unique
  order      PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerId    String
  buyer      Business      @relation("RatingBuyer", fields: [buyerId], references: [id])
  supplierId String
  supplier   Business      @relation("RatingSupplier", fields: [supplierId], references: [id])
  quality    Int
  accuracy   Int
  timeliness Int
  price      Int
  comment    String?
  createdAt  DateTime      @default(now())
}

enum StorageLocation {
  DRY_STORE
  COLD_ROOM
  FREEZER
  OTHER
}

model StockItem {
  id            String          @id @default(cuid())
  buyerId       String
  buyer         Business        @relation(fields: [buyerId], references: [id])
  name          String
  unit          String
  location      StorageLocation @default(DRY_STORE)
  reorderLevel  Float           @default(0)
  reorderQty    Float           @default(0)
  lastUnitPrice Int?
  createdAt     DateTime        @default(now())

  batches   StockBatch[]
  movements StockMovement[]
  usedIn    RecipeIngredient[]
  cutFrom   PortionRun[]       @relation("PortionFrom")
  cutInto   PortionRun[]       @relation("PortionTo")

  @@unique([buyerId, name, unit])
}

model StockBatch {
  id         String    @id @default(cuid())
  itemId     String
  item       StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity   Float // remaining
  receivedAt DateTime  @default(now())
  expiresAt  DateTime?
}

enum MovementType {
  RECEIVED
  ADDED
  USED
  WASTED
  COUNT_ADJUST
  SOLD // taken out by dishes sold (from recipes)
  PORTIONED // bulk taken out (-) or pieces added (+) when cutting into portions
}

model StockMovement {
  id       String         @id @default(cuid())
  itemId   String
  item     StockItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type     MovementType
  quantity Float // signed: + in, - out
  reason   String?
  userId   String
  user     User           @relation(fields: [userId], references: [id])
  orderId  String?
  order    PurchaseOrder? @relation(fields: [orderId], references: [id])
  at       DateTime       @default(now())
}

/**
 * ---------------- supplier price lists ----------------
 */

model CatalogItem {
  id         String    @id @default(cuid())
  supplierId String
  supplier   Business  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  name       String
  unit       String
  price      Int // Naira per unit
  minQty     Float     @default(0)
  available  Boolean   @default(true)
  updatedAt  DateTime  @updatedAt
  createdAt  DateTime  @default(now())

  priceChanges CatalogPriceChange[]

  @@unique([supplierId, name, unit])
}

/**
 * Every price a supplier puts on their list, so buyers can see how steady their prices are.
 * Kept (with the item's name and unit) after an item is removed.
 */
model CatalogPriceChange {
  id         String       @id @default(cuid())
  supplierId String
  supplier   Business     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  itemId     String?
  item       CatalogItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name       String
  unit       String
  oldPrice   Int? // null when the item was first added
  newPrice   Int
  source     String       @default("PRICE_LIST") // PRICE_LIST, ADMIN, RATE_CARD
  at         DateTime     @default(now())

  @@index([supplierId, at])
}

/**
 * A supplier's rate card (PDF, photo or spreadsheet), stored in the database.
 */
model RateCard {
  id         String    @id @default(cuid())
  supplierId String
  supplier   Business  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  size       Int
  data       Bytes
  validFrom  DateTime?
  note       String?
  uploadedBy String // name of whoever uploaded it
  createdAt  DateTime  @default(now())

  @@index([supplierId, createdAt])
}

/**
 * ---------------- recipes and menu costing ----------------
 */

model Recipe {
  id          String             @id @default(cuid())
  buyerId     String
  buyer       Business           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  name        String
  menuPrice   Int // Naira per portion
  portions    Float              @default(1) // portions one batch of the ingredients makes
  notes       String?
  createdAt   DateTime           @default(now())
  ingredients RecipeIngredient[]
  sales       DishSale[]

  @@unique([buyerId, name])
}

model RecipeIngredient {
  id       String    @id @default(cuid())
  recipeId String
  recipe   Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  itemId   String
  item     StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity Float // in the stock item's unit, for one batch

  @@unique([recipeId, itemId])
}

model DishSale {
  id       String   @id @default(cuid())
  recipeId String
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  quantity Int
  soldOn   DateTime
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  at       DateTime @default(now())
}

/**
 * ---------------- portion control ----------------
 */

/**
 * Bulk stock (e.g. 10 kg chicken) cut into counted, weighed pieces.
 */
model PortionRun {
  id          String    @id @default(cuid())
  buyerId     String
  buyer       Business  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  fromItemId  String
  fromItem    StockItem @relation("PortionFrom", fields: [fromItemId], references: [id], onDelete: Cascade)
  toItemId    String
  toItem      StockItem @relation("PortionTo", fields: [toItemId], references: [id], onDelete: Cascade)
  inputQty    Float // in the bulk item's unit
  pieces      Int
  totalWeight Float? // kg, of all the pieces after cutting
  cost        Int // Naira value of the bulk taken
  note        String?
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  at          DateTime  @default(now())
}

/**
 * ---------------- audit log ----------------
 */

/**
 * One line per important action (sign-ins, team and role changes, approvals, payments,
 * admin changes). Written by src/lib/audit.ts, read on /admin/audit. Never edited.
 */
model AuditLog {
  id         String    @id @default(cuid())
  at         DateTime  @default(now())
  actorId    String?
  actor      User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName  String? // kept even if the user is removed later
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  action     String // e.g. "auth.login", "team.role_changed", "order.approved"
  summary    String // plain sentence shown to admins
  targetType String? // e.g. "User", "PurchaseOrder"
  targetId   String?

  @@index([at])
  @@index([businessId, at])
  @@index([action, at])
}
